{#- VHDL Testbench template for AXI-Lite to Local Bus bridge #}
-- Created with Corsair v{{ corsair_ver }}
--
-- Testbench for {{ dut_name }}
--

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity {{ tb_name }} is
end {{ tb_name }};

architecture testbench of {{ tb_name }} is

    -- Component declaration
    component {{ dut_name }}
    generic(
        ADDR_W      : integer := {{ config['address_width'] }};
        DATA_W      : integer := {{ config['data_width'] }};
        STRB_W      : integer := {{ config['data_width'] // 8 }};
        BASE_ADDR   : std_logic_vector({{ config['address_width'] }}-1 downto 0) := x"{{ '%08X' | format(config['base_address']) if config['address_width'] <= 32 else '%016X' | format(config['base_address']) }}"
    );
    port(
        clk    : in std_logic;
        rst    : in std_logic;
        -- Local Bus
        wready : in  std_logic;
        waddr  : out std_logic_vector(ADDR_W-1 downto 0);
        wdata  : out std_logic_vector(DATA_W-1 downto 0);
        wen    : out std_logic;
        wstrb  : out std_logic_vector(STRB_W-1 downto 0);
        rdata  : in  std_logic_vector(DATA_W-1 downto 0);
        rvalid : in  std_logic;
        raddr  : out std_logic_vector(ADDR_W-1 downto 0);
        ren    : out std_logic;
        -- AXI-Lite
        axil_awaddr   : in  std_logic_vector(ADDR_W-1 downto 0);
        axil_awprot   : in  std_logic_vector(2 downto 0);
        axil_awvalid  : in  std_logic;
        axil_awready  : out std_logic;
        axil_wdata    : in  std_logic_vector(DATA_W-1 downto 0);
        axil_wstrb    : in  std_logic_vector(STRB_W-1 downto 0);
        axil_wvalid   : in  std_logic;
        axil_wready   : out std_logic;
        axil_bresp    : out std_logic_vector(1 downto 0);
        axil_bvalid   : out std_logic;
        axil_bready   : in  std_logic;
        axil_araddr   : in  std_logic_vector(ADDR_W-1 downto 0);
        axil_arprot   : in  std_logic_vector(2 downto 0);
        axil_arvalid  : in  std_logic;
        axil_arready  : out std_logic;
        axil_rdata    : out std_logic_vector(DATA_W-1 downto 0);
        axil_rresp    : out std_logic_vector(1 downto 0);
        axil_rvalid   : out std_logic;
        axil_rready   : in  std_logic
    );
    end component;

    -- Constants
    constant ADDR_W : integer := {{ config['address_width'] }};
    constant DATA_W : integer := {{ config['data_width'] }};
    constant STRB_W : integer := {{ config['data_width'] // 8 }};
    constant CLK_PERIOD : time := 10 ns;
    
    -- Clock and reset signals
    signal clk : std_logic := '0';
    signal rst : std_logic := {% if 'pos' in config['register_reset'] %}'1'{% else %}'0'{% endif %};
    
    -- Local Bus signals
    signal wready : std_logic := '1';
    signal waddr  : std_logic_vector(ADDR_W-1 downto 0);
    signal wdata  : std_logic_vector(DATA_W-1 downto 0);
    signal wen    : std_logic;
    signal wstrb  : std_logic_vector(STRB_W-1 downto 0);
    signal rdata  : std_logic_vector(DATA_W-1 downto 0) := (others => '0');
    signal rvalid : std_logic := '0';
    signal raddr  : std_logic_vector(ADDR_W-1 downto 0);
    signal ren    : std_logic;
    
    -- AXI-Lite signals
    signal axil_awaddr  : std_logic_vector(ADDR_W-1 downto 0) := (others => '0');
    signal axil_awprot  : std_logic_vector(2 downto 0) := (others => '0');
    signal axil_awvalid : std_logic := '0';
    signal axil_awready : std_logic;
    signal axil_wdata   : std_logic_vector(DATA_W-1 downto 0) := (others => '0');
    signal axil_wstrb   : std_logic_vector(STRB_W-1 downto 0) := (others => '0');
    signal axil_wvalid  : std_logic := '0';
    signal axil_wready  : std_logic;
    signal axil_bresp   : std_logic_vector(1 downto 0);
    signal axil_bvalid  : std_logic;
    signal axil_bready  : std_logic := '0';
    signal axil_araddr  : std_logic_vector(ADDR_W-1 downto 0) := (others => '0');
    signal axil_arprot  : std_logic_vector(2 downto 0) := (others => '0');
    signal axil_arvalid : std_logic := '0';
    signal axil_arready : std_logic;
    signal axil_rdata   : std_logic_vector(DATA_W-1 downto 0);
    signal axil_rresp   : std_logic_vector(1 downto 0);
    signal axil_rvalid  : std_logic;
    signal axil_rready  : std_logic := '0';
    
    -- Test control
    signal test_done : boolean := false;
    signal error_count : integer := 0;

begin

    -- Clock generation
    clk_proc: process
    begin
        while not test_done loop
            clk <= '0';
            wait for CLK_PERIOD / 2;
            clk <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
        wait;
    end process;

    -- Reset generation
    reset_proc: process
    begin
        rst <= {% if 'pos' in config['register_reset'] %}'1'{% else %}'0'{% endif %};
        wait for CLK_PERIOD * 5;
        rst <= {% if 'pos' in config['register_reset'] %}'0'{% else %}'1'{% endif %};
        wait;
    end process;

    -- DUT instantiation
    dut: {{ dut_name }}
    generic map(
        ADDR_W    => ADDR_W,
        DATA_W    => DATA_W,
        STRB_W    => STRB_W,
        BASE_ADDR => x"{{ '%08X' | format(config['base_address']) if config['address_width'] <= 32 else '%016X' | format(config['base_address']) }}"
    )
    port map(
        clk           => clk,
        rst           => rst,
        wready        => wready,
        waddr         => waddr,
        wdata         => wdata,
        wen           => wen,
        wstrb         => wstrb,
        rdata         => rdata,
        rvalid        => rvalid,
        raddr         => raddr,
        ren           => ren,
        axil_awaddr   => axil_awaddr,
        axil_awprot   => axil_awprot,
        axil_awvalid  => axil_awvalid,
        axil_awready  => axil_awready,
        axil_wdata    => axil_wdata,
        axil_wstrb    => axil_wstrb,
        axil_wvalid   => axil_wvalid,
        axil_wready   => axil_wready,
        axil_bresp    => axil_bresp,
        axil_bvalid   => axil_bvalid,
        axil_bready   => axil_bready,
        axil_araddr   => axil_araddr,
        axil_arprot   => axil_arprot,
        axil_arvalid  => axil_arvalid,
        axil_arready  => axil_arready,
        axil_rdata    => axil_rdata,
        axil_rresp    => axil_rresp,
        axil_rvalid   => axil_rvalid,
        axil_rready   => axil_rready
    );

    -- Local Bus slave model (simple response)
    lb_slave_proc: process(clk)
    begin
        if rising_edge(clk) then
            if rst = {% if 'pos' in config['register_reset'] %}'1'{% else %}'0'{% endif %} then
                rvalid <= '0';
                rdata <= (others => '0');
            else
                -- Handle read requests
                if ren = '1' and rvalid = '0' then
                    rvalid <= '1';
                    -- Return address as data for simple testing
                    rdata <= std_logic_vector(resize(unsigned(raddr), DATA_W));
                elsif rvalid = '1' then
                    rvalid <= '0';
                end if;
            end if;
        end if;
    end process;

    -- Stimulus process
    stim_proc: process
        variable addr : std_logic_vector(ADDR_W-1 downto 0);
        variable data : std_logic_vector(DATA_W-1 downto 0);
        variable expected_data : std_logic_vector(DATA_W-1 downto 0);
    begin
        -- Wait for reset
        wait until rst = {% if 'pos' in config['register_reset'] %}'0'{% else %}'1'{% endif %};
        wait for CLK_PERIOD * 2;
        
        report "Starting testbench for {{ dut_name }}";
        
        -- Test 1: Simple write transaction
        report "Test 1: Simple write transaction";
        addr := x"{{ '%08X' | format(0x00000004) if config['address_width'] <= 32 else '%016X' | format(0x00000004) }}";
        data := x"{{ '%08X' | format(0xDEADBEEF) if config['data_width'] <= 32 else '%016X' | format(0xDEADBEEF) }}";
        
        axil_awaddr <= addr;
        axil_awvalid <= '1';
        axil_wdata <= data;
        axil_wstrb <= (others => '1');
        axil_wvalid <= '1';
        axil_bready <= '1';
        
        wait until axil_awready = '1';
        wait for CLK_PERIOD;
        axil_awvalid <= '0';
        
        wait until axil_wready = '1';
        wait for CLK_PERIOD;
        axil_wvalid <= '0';
        
        wait until axil_bvalid = '1';
        wait for CLK_PERIOD;
        axil_bready <= '0';
        
        if axil_bresp /= "00" then
            report "Test 1 FAILED: Write response error" severity error;
            error_count <= error_count + 1;
        else
            report "Test 1 PASSED: Write transaction completed";
        end if;
        
        wait for CLK_PERIOD * 2;
        
        -- Test 2: Simple read transaction
        report "Test 2: Simple read transaction";
        addr := x"{{ '%08X' | format(0x00000008) if config['address_width'] <= 32 else '%016X' | format(0x00000008) }}";
        expected_data := std_logic_vector(resize(unsigned(addr), DATA_W));
        
        axil_araddr <= addr;
        axil_arvalid <= '1';
        axil_rready <= '1';
        
        wait until axil_arready = '1';
        wait for CLK_PERIOD;
        axil_arvalid <= '0';
        
        wait until axil_rvalid = '1';
        data := axil_rdata;
        wait for CLK_PERIOD;
        axil_rready <= '0';
        
        if data /= expected_data then
            report "Test 2 FAILED: Read data mismatch" severity error;
            error_count <= error_count + 1;
        elsif axil_rresp /= "00" then
            report "Test 2 FAILED: Read response error" severity error;
            error_count <= error_count + 1;
        else
            report "Test 2 PASSED: Read transaction completed";
        end if;
        
        wait for CLK_PERIOD * 2;
        
        -- Test 3: Write with byte strobes
        report "Test 3: Write with byte strobes";
        addr := x"{{ '%08X' | format(0x0000000C) if config['address_width'] <= 32 else '%016X' | format(0x0000000C) }}";
        data := x"{{ '%08X' | format(0xCAFEBABE) if config['data_width'] <= 32 else '%016X' | format(0xCAFEBABE) }}";
        
        axil_awaddr <= addr;
        axil_awvalid <= '1';
        axil_wdata <= data;
        axil_wstrb <= "0110"; -- Only middle bytes
        axil_wvalid <= '1';
        axil_bready <= '1';
        
        wait until axil_awready = '1';
        wait for CLK_PERIOD;
        axil_awvalid <= '0';
        
        wait until axil_wready = '1';
        wait for CLK_PERIOD;
        axil_wvalid <= '0';
        
        wait until axil_bvalid = '1';
        wait for CLK_PERIOD;
        axil_bready <= '0';
        
        if wstrb /= "0110" then
            report "Test 3 FAILED: Write strobe mismatch" severity error;
            error_count <= error_count + 1;
        elsif axil_bresp /= "00" then
            report "Test 3 FAILED: Write response error" severity error;
            error_count <= error_count + 1;
        else
            report "Test 3 PASSED: Write with strobes completed";
        end if;
        
        wait for CLK_PERIOD * 5;
        
        -- Report results
        if error_count = 0 then
            report "ALL TESTS PASSED" severity note;
        else
            report "TESTS FAILED with " & integer'image(error_count) & " errors" severity error;
        end if;
        
        test_done <= true;
        wait;
    end process;

    -- Timeout watchdog
    timeout_proc: process
    begin
        wait for 10 us;
        if not test_done then
            report "TIMEOUT: Test did not complete" severity failure;
            test_done <= true;
        end if;
        wait;
    end process;

end testbench;
